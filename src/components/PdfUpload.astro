---
import PdfPreview from './PdfPreview.astro';
import '../styles/pdf-upload.css';
---

<main class="pdf-upload">
  <div id="upload-stage">
    <section class="intro" aria-labelledby="upload-heading">
      <p class="eyebrow">Chip - Potatohead's DnD Character Sheet</p>
      <h2 id="upload-heading">Bring your character sheet from DnDBeyond</h2>
      <p class="description">
        Drop a PDF here to get started, or choose one from your device.
      </p>
    </section>

    <section class="upload-card" aria-label="Upload a PDF character sheet">
      <div class="drop-zone" id="drop-zone">
        <div class="file-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none">
            <path d="M13 5.5h14l9 9v27H13v-36Z" />
            <path d="M27 5.5v10h9M19 27h11M19 33h11" />
            <path d="M8 12.5v31h23" />
          </svg>
        </div>
        <h3>Drop your PDF here</h3>
        <span class="divider"><span>or</span></span>
        <button class="choose-button" id="choose-file" type="button">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M10 13V3m0 0L6 7m4-4 4 4M4 12v4h12v-4" />
          </svg>
          Choose a PDF
        </button>
        <input
          id="pdf-input"
          type="file"
          accept=".pdf,application/pdf"
          tabindex="-1"
          aria-label="Choose a PDF file"
          aria-hidden="true"
        />
      </div>
      <p class="file-status" id="file-status" role="status" aria-live="polite">
        No file selected yet
      </p>
    </section>
    <p class="privacy-note">
      Your file doesn't leave this device.
    </p>
  </div>

  <div id="preview-stage" hidden>
    <PdfPreview />
  </div>
</main>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  import pdfWorkerUrl from 'pdfjs-dist/build/pdf.worker.min.mjs?url';

  pdfjsLib.GlobalWorkerOptions.workerSrc = pdfWorkerUrl;

  const dropZone = document.querySelector('#drop-zone');
  const fileInput = document.querySelector('#pdf-input');
  const chooseButton = document.querySelector('#choose-file');
  const fileStatus = document.querySelector('#file-status');
  const uploadStage = document.querySelector('#upload-stage');
  const previewStage = document.querySelector('#preview-stage');
  const previewSummary = document.querySelector('#pdf-preview-summary');
  const previewTables = document.querySelector('#pdf-tables');

  if (
    dropZone instanceof HTMLElement &&
    fileInput instanceof HTMLInputElement &&
    chooseButton instanceof HTMLButtonElement &&
    fileStatus instanceof HTMLElement &&
    uploadStage instanceof HTMLElement &&
    previewStage instanceof HTMLElement &&
    previewSummary instanceof HTMLElement &&
    previewTables instanceof HTMLElement
  ) {
    let currentRequest = 0;

    type ExtractedTable = {
      title: string;
      columns: string[];
      rows: string[][];
      rowSpans?: number[][];
      description?: string;
    };

    const normalizeFieldName = (name: string) =>
      name.replace(/\s+/g, '').toLowerCase();

    const getField = (fields: Map<string, string>, ...names: string[]) =>
      names
        .map((name) => fields.get(normalizeFieldName(name)))
        .find((value) => value) ?? '';

    const buildTables = (
      fields: Map<string, string>,
      featureTraitFields: [string, string][],
    ): ExtractedTable[] => {
      const tables: ExtractedTable[] = [];
      const addTable = (title: string, columns: string[], rows: string[][]) => {
        const nonemptyRows = rows.filter((row) => row.some((cell) => cell.trim()));
        if (nonemptyRows.length) tables.push({ title, columns, rows: nonemptyRows });
      };
      const addTextSection = (
        title: string,
        description: string,
        columns: string[] = [],
        rows: string[][] = [],
      ) => tables.push({ title, description, columns, rows });
      const indexedRows = (
        limit: number,
        getName: (index: number) => string,
        getValues: (index: number) => string[],
      ) =>
        Array.from({ length: limit }, (_, index) => {
          const name = getName(index);
          return name ? [name, ...getValues(index)] : null;
        }).filter((row): row is string[] => row !== null);

      addTable(
        'Character',
        ['Field', 'Value'],
        [
          ['Initiative', getField(fields, 'Init')],
          ['Speed', getField(fields, 'Speed')],
          ['Max hit points', getField(fields, 'MaxHP')],
          [
            'Proficiency bonus',
            getField(fields, 'ProfBonus', 'Proficiency Bonus'),
          ],
        ],
      );
      const savingThrows: [string, string][] = [
        ['Strength', 'STR'],
        ['Dexterity', 'DEX'],
        ['Constitution', 'CON'],
        ['Intelligence', 'INT'],
        ['Wisdom', 'WIS'],
        ['Charisma', 'CHA'],
      ];
      const armorClass = getField(fields, 'AC');
      const defensesEntry = getField(fields, 'Defenses');
      const defensesDescription = [
        armorClass && `Armor class: ${armorClass}`,
        defensesEntry,
      ]
        .filter(Boolean)
        .join('\n');
      const savingThrowRows = savingThrows
        .map(([ability, abbreviation]) => [
          `${ability} saving throw`,
          getField(
            fields,
            `ST ${ability}`,
            `${ability} Save`,
            `${abbreviation} Save`,
          ),
        ])
        .filter((row) => row[1].trim());
      if (defensesDescription || savingThrowRows.length) {
        addTextSection(
          'Defenses',
          defensesDescription,
          ['Saving throw', 'Value'],
          savingThrowRows,
        );
      }
      const sensesDescription = getField(fields, 'Senses');
      const passiveSenses: [string, string, string][] = [
        ['Passive Perception', 'PassivePerception', 'Perception'],
        ['Passive Insight', 'PassiveInsight', 'Insight'],
        ['Passive Investigation', 'PassiveInvestigation', 'Investigation'],
      ];
      const passiveSenseRows = passiveSenses
        .map(([sense, field, skill]) => {
          const explicitValue = getField(fields, field);
          if (explicitValue) return [sense, explicitValue];

          const skillValue = getField(fields, skill);
          const parsedSkillValue = skillValue.match(/^[+-]?\d+/)?.[0];
          return [
            sense,
            parsedSkillValue ? String(10 + Number(parsedSkillValue)) : '',
          ];
        })
        .filter((row) => row[1].trim());
      if (sensesDescription || passiveSenseRows.length) {
        addTextSection(
          'Senses',
          sensesDescription,
          ['Passive sense', 'Value'],
          passiveSenseRows,
        );
      }
      const featureTraitSections = featureTraitFields
        .map(([name, value]) => [
          name.toLowerCase().replace(/[^a-z0-9]/g, ''),
          value,
        ] as const)
        .filter(([name]) => name.includes('feature') && name.includes('trait'))
        .flatMap(([, value]) => value.split('*').map((section) => section.trim()))
        .filter(Boolean);
      const featureGroups = {
        action: [] as string[],
        bonusAction: [] as string[],
        reaction: [] as string[],
        limitedResources: [] as string[],
        others: [] as string[],
      };
      for (const feature of featureTraitSections) {
        const isBonusAction = /\bbonus\s+action\b/i.test(feature);
        const isAction = /\baction\b/i.test(feature) && !isBonusAction;
        const isReaction = /\breaction\b/i.test(feature);
        const isLimitedResource = /\b(?:short or long|short|long) rest\b/i.test(feature);

        if (isBonusAction) {
          featureGroups.bonusAction.push(feature);
        } else if (isAction) {
          featureGroups.action.push(feature);
        }
        if (isReaction) {
          featureGroups.reaction.push(feature);
        }
        if (isLimitedResource) {
          featureGroups.limitedResources.push(feature);
        }
        if (!isBonusAction && !isAction && !isReaction && !isLimitedResource) {
          featureGroups.others.push(feature);
        }
      }
      for (const [title, description] of [
        ['Action', featureGroups.action.join('\n')],
        ['Bonus Action', featureGroups.bonusAction.join('\n')],
        ['Reaction', featureGroups.reaction.join('\n')],
        ['Limited Resources', featureGroups.limitedResources.join('\n')],
        ['Others', featureGroups.others.join('\n')],
      ]) {
        addTextSection(title, description);
      }

      const abilities: [string, string, string, [string, string][]][] = [
        ['Strength', 'STR', 'STRmod', [['Athletics', 'Athletics']]],
        [
          'Dexterity',
          'DEX',
          'DEXmod',
          [
            ['Acrobatics', 'Acrobatics'],
            ['Sleight of Hand', 'SleightofHand'],
            ['Stealth', 'Stealth'],
          ],
        ],
        ['Constitution', 'CON', 'CONmod', []],
        [
          'Intelligence',
          'INT',
          'INTmod',
          [
            ['Arcana', 'Arcana'],
            ['History', 'History'],
            ['Investigation', 'Investigation'],
            ['Nature', 'Nature'],
            ['Religion', 'Religion'],
          ],
        ],
        [
          'Wisdom',
          'WIS',
          'WISmod',
          [
            ['Animal Handling', 'Animal'],
            ['Insight', 'Insight'],
            ['Medicine', 'Medicine'],
            ['Perception', 'Perception'],
            ['Survival', 'Survival'],
          ],
        ],
        [
          'Charisma',
          'CHA',
          'CHamod',
          [
            ['Deception', 'Deception'],
            ['Intimidation', 'Intimidation'],
            ['Performance', 'Performance'],
            ['Persuasion', 'Persuasion'],
          ],
        ],
      ];
      const abilitySkillRows: string[][] = [];
      const abilitySkillRowSpans: number[][] = [];
      for (const [name, score, modifier, skills] of abilities) {
        const abilitySkills = skills.length ? skills : [['', '']];
        abilitySkills.forEach(([label, field], skillIndex) => {
          const proficiency = getField(fields, `${field}Prof`);
          const abilityModifierText = getField(fields, modifier);
          const abilityValue = [
            abilityModifierText,
            getField(fields, score),
          ]
            .filter(Boolean)
            .join(' / ');
          abilitySkillRows.push([
            `${name} (${score})`,
            abilityValue,
            label,
            proficiency === 'E'
              ? '✓✓'
              : proficiency === 'P'
                ? '✓'
                : '',
            field ? getField(fields, field, `${field}Mod`) : '',
          ]);
          abilitySkillRowSpans.push(
            skillIndex === 0
              ? [abilitySkills.length, abilitySkills.length, 1, 1, 1]
              : [0, 0, 1, 1, 1],
          );
        });
      }
      tables.push({
        title: 'Ability scores and skills',
        columns: ['Ability', 'Modifier / score', 'Skill', 'Proficiency', 'Skill value'],
        rows: abilitySkillRows,
        rowSpans: abilitySkillRowSpans,
      });

      const attunedItems = indexedRows(
        20,
        (index) => getField(fields, `Attuned Name${index + 1}`),
        (index) => [
          getField(fields, `Attuned Qty${index + 1}`),
          getField(fields, `Attuned Weight${index + 1}`),
        ],
      );
      addTable('Attuned items', ['Item', 'Quantity', 'Weight'], attunedItems);

      const spells = indexedRows(
        200,
        (index) => getField(fields, `spellName${index}`),
        (index) => [
          getField(fields, `spellSource${index}`),
          getField(fields, `spellCastingTime${index}`),
          getField(fields, `spellRange${index}`),
          getField(fields, `spellComponents${index}`),
          getField(fields, `spellDuration${index}`),
          getField(fields, `spellSaveHit${index}`),
          getField(fields, `spellPrepared${index}`),
          getField(fields, `spellPage${index}`),
          getField(fields, `spellNotes${index}`),
        ],
      );
      addTable(
        'Spells',
        [
          'Spell',
          'Source',
          'Casting time',
          'Range',
          'Components',
          'Duration',
          'Save / attack',
          'Prepared',
          'Page',
          'Notes',
        ],
        spells,
      );

      return tables;
    };

    const renderTables = (tables: ExtractedTable[]) => {
      previewTables.replaceChildren();

      for (const tableData of tables) {
        const section = document.createElement('section');
        section.className = 'pdf-preview__table-section';

        const heading = document.createElement('h3');
        heading.textContent = tableData.title;
        section.append(heading);

        if (tableData.description) {
          const description = document.createElement('p');
          description.className = 'pdf-preview__table-description';
          description.textContent = tableData.description;
          section.append(description);
        }

        if (tableData.rows.length) {
          const scrollContainer = document.createElement('div');
          scrollContainer.className = 'pdf-preview__table-scroll';

          const table = document.createElement('table');
          const head = table.createTHead().insertRow();
          for (const column of tableData.columns) {
            const cell = document.createElement('th');
            cell.scope = 'col';
            cell.textContent = column;
            head.append(cell);
          }

          const body = table.createTBody();
          tableData.rows.forEach((rowData, rowIndex) => {
            const row = body.insertRow();
            rowData.forEach((value, columnIndex) => {
              const rowSpan = tableData.rowSpans?.[rowIndex]?.[columnIndex] ?? 1;
              if (rowSpan === 0) return;
              const cell = row.insertCell();
              cell.textContent = value;
              if (rowSpan > 1) cell.rowSpan = rowSpan;
              if (tableData.columns[columnIndex] === 'Proficiency' && value) {
                cell.className = 'pdf-preview__proficiency';
                cell.setAttribute(
                  'aria-label',
                  value === '✓✓' ? 'Expertise' : 'Proficient',
                );
                cell.title = value === '✓✓' ? 'Expertise' : 'Proficient';
              }
            });
          });

          scrollContainer.append(table);
          section.append(scrollContainer);
        }
        previewTables.append(section);
      }
    };

    const showFile = async (file: File) => {
      const request = ++currentRequest;

      if (!file.name.toLowerCase().endsWith('.pdf')) {
        fileStatus.textContent = 'That file is not a PDF. Please choose a PDF file.';
        fileStatus.classList.add('error');
        return;
      }

      fileStatus.textContent = `Reading ${file.name}…`;
      fileStatus.classList.remove('error');

      let loadingTask: pdfjsLib.PDFDocumentLoadingTask | undefined;

      try {
        const data = new Uint8Array(await file.arrayBuffer());
        loadingTask = pdfjsLib.getDocument({ data });
        const pdf = await loadingTask.promise;
        const fields = new Map<string, string>();
        const featureTraitFields: [string, string][] = [];
        const seenFeatureTraitValues = new Set<string>();
        for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
          const page = await pdf.getPage(pageNumber);
          const annotations = await page.getAnnotations();
          for (const annotation of annotations) {
            if (
              'fieldName' in annotation &&
              typeof annotation.fieldName === 'string' &&
              'fieldValue' in annotation &&
              typeof annotation.fieldValue === 'string' &&
              annotation.fieldValue.trim()
            ) {
              const name = normalizeFieldName(annotation.fieldName);
              if (!fields.has(name)) fields.set(name, annotation.fieldValue.trim());
              const normalizedFeatureName = annotation.fieldName
                .toLowerCase()
                .replace(/[^a-z0-9]/g, '');
              if (
                normalizedFeatureName.includes('feature') &&
                normalizedFeatureName.includes('trait')
              ) {
                const value = annotation.fieldValue.trim();
                const key = `${normalizedFeatureName}\u0000${value}`;
                if (!seenFeatureTraitValues.has(key)) {
                  seenFeatureTraitValues.add(key);
                  featureTraitFields.push([annotation.fieldName, value]);
                }
              }
            }
          }
        }

        if (request === currentRequest) {
          const tables = buildTables(fields, featureTraitFields);
          if (!tables.length) {
            fileStatus.textContent =
              'No filled character-sheet fields were found. This extractor supports fillable PDFs, not flattened or scanned sheets.';
            fileStatus.classList.add('error');
            return;
          }

          renderTables(tables);
          previewSummary.textContent = `Extracted ${tables.length} table${tables.length === 1 ? '' : 's'} from ${file.name}.`;
          uploadStage.hidden = true;
          previewStage.hidden = false;
        }
      } catch (error) {
        if (request === currentRequest) {
          fileStatus.textContent =
            'Could not read this PDF. It may be damaged or password-protected.';
          fileStatus.classList.add('error');
        }
        console.error('Failed to parse uploaded PDF:', error);
      } finally {
        if (loadingTask) {
          await loadingTask.destroy();
        }
      }
    };

    chooseButton.addEventListener('click', () => fileInput.click());

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      fileInput.value = '';
      if (file) void showFile(file);
    });

    dropZone.addEventListener('dragover', (event) => {
      event.preventDefault();
      dropZone.classList.add('dragging');
    });

    dropZone.addEventListener('dragleave', (event) => {
      if (!(event.relatedTarget instanceof Node) || !dropZone.contains(event.relatedTarget)) {
        dropZone.classList.remove('dragging');
      }
    });

    dropZone.addEventListener('drop', (event) => {
      event.preventDefault();
      dropZone.classList.remove('dragging');
      const file = event.dataTransfer?.files[0];
      if (file) void showFile(file);
    });
  }
</script>
