---
import '../styles/pdf-preview.css';
---

<section class="pdf-preview" aria-labelledby="pdf-preview-heading">
  <header class="pdf-preview__header">
    <p class="pdf-preview__eyebrow">PDF parsed on your device</p>
    <h2 id="pdf-preview-heading">Tables from your character sheet</h2>
    <p id="pdf-preview-summary" aria-live="polite"></p>
  </header>
  <div id="pdf-tables" class="pdf-preview__tables"></div>
</section>
